breakpoint;

alias process_table_entry R1;

process_table_entry = PROCESS_TABLE + [SYSTEM_STATUS_TABLE + 1] * 16;

[process_table_entry + 9] = -1;
[process_table_entry + 13] = SP;
SP = [process_table_entry + 11] * 512 - 1;

backup;

multipush(EIP);

if ((EC != 0) || ([process_table_entry + 13] == (PTLR * 512 - 1))) then
    if (EC == 0) then
        print "Stack overflow";
    endif;
    if (EC == 1) then
        print "Illegal instruction";
    endif;
    if (EC == 2) then
        print "Illegal memory access";
    endif;
    if (EC == 3) then
        print "Arithmetic Exception";
    endif;

    multipush(R0);

    R1 = EXIT_PROCESS;
    R2 = [SYSTEM_STATUS_TABLE + 1];
    call PROCESS_MANAGER;

    call SCHEDULER;

    multipop(R0);
else
if (EPN > 3 && EPN < 8) then // code page
    alias page_table_entry R2;
    page_table_entry = PAGE_TABLE_BASE + [SYSTEM_STATUS_TABLE + 1] * 20;

    multipush(R0, R1, R2, EPN);

    R1 = GET_CODE_PAGE;
    R2 = [DISK_MAP_TABLE + [SYSTEM_STATUS_TABLE + 1] * 10 + EPN];
    call MEMORY_MANAGER;

    multipop(R2, EPN);
    [page_table_entry + 2 * EPN] = R0;
    [page_table_entry + 2 * EPN + 1] = "1100";

    multipop(R0, R1);
else
    // Heap page
    multipush(R0, R1);

    R1 = GET_FREE_PAGE;
    call MEMORY_MANAGER;
    [PTBR + 4] = R0;
    [PTBR + 5] = "1110";

    R1 = GET_FREE_PAGE;
    call MEMORY_MANAGER;
    [PTBR + 6] = R0;
    [PTBR + 7] = "1110";

    multipop(R0, R1);
endif;
endif;

[process_table_entry + 9] = 0;

multipop(EIP);

restore;

SP = [process_table_entry + 13];
SP = SP + 1;

[[PTBR + 2 * (SP / 512)] * 512 + (SP % 512)] = EIP;

ireturn;
